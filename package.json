{
  "name": "home-inventory-sales",
  "version": "0.0.1",
  "description": "A lightweight inventory and sales tracker for home businesses.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wrangler": "wrangler dev",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "npm run build && npm run test:unit && npm run test:worker"
  },
  "dependencies": {
    "preact": "^10.22.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^5.20260808.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
